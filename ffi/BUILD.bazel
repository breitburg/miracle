load("@rules_rust//rust:defs.bzl", "rust_static_library")

# Language-neutral C ABI over //core, generated by UniFFI. Each foreign
# platform runs its own uniffi-bindgen on this archive (library mode).
rust_static_library(
    name = "miracle_ffi",
    srcs = glob(["src/**/*.rs"]),
    # Stub manifest; UniFFI's proc-macros read the crate name from it.
    compile_data = ["Cargo.toml"],
    crate_name = "miracle_ffi",
    visibility = ["//platforms:__subpackages__"],
    deps = [
        "//core:miracle_core",
        "@crates//:uniffi",
    ],
)
